# Copy to .env and fill in. Never commit .env.

# --- Claude -------------------------------------------------------------------
# Optional: enables the three "Ask the agents" assistants, grant-section drafts and member bios.
# Everything else works without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Coalition legal profile (drives grant eligibility) -------------------------
# NONPROFIT_501C3 | COOPERATIVE | LLC | FISCALLY_SPONSORED
COALITION_NAME=Killette Industries Coalition
COALITION_ENTITY_TYPE=NONPROFIT_501C3
COALITION_SAM_REGISTERED=true      # federal grants require active SAM.gov registration (UEI)
COALITION_INDIRECT_RATE_PCT=15     # negotiated or de minimis rate, % of modified total direct costs

# --- Kill switch --------------------------------------------------------------
# false = every model call is refused (fails closed). The engines keep working.
AI_ENABLED=true
# Set to enable the runtime kill switch on /governance (header X-Admin-Token).
# Leave empty to lock it; AI_ENABLED=false always works.
ADMIN_TOKEN=

# --- Human gates ----------------------------------------------------------------
# Optional: if set, every review decision, resource-request decision, action decision and
# human-written grant section must send header X-Reviewer-Token.
REVIEWER_TOKEN=

# --- Access ---------------------------------------------------------------------
# The landing page (/) is public. The agents console (/console), governance page, API
# and API docs require this username and password. With no password set they stay locked.
CONSOLE_AUTH=true
CONSOLE_USERNAME=ki
CONSOLE_PASSWORD=

# --- Limiter ------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=5        # AI requests per visitor per minute (all three agents combined)
DAILY_CAP_PER_VISITOR=25       # AI requests per visitor per UTC day
DAILY_CAP_GLOBAL=200           # AI requests, all visitors, per UTC day
DAILY_TOKEN_BUDGET=400000      # input + output tokens, all visitors, per UTC day
MAX_TOKENS=1024                # max_tokens per agent model call
DRAFT_MAX_TOKENS=700           # max_tokens for a grant-section or bio draft
MAX_AGENT_TURNS=6              # tool round trips per question
MAX_REQUEST_BYTES=16384        # largest request body accepted (413 above this)
MAX_QUESTION_CHARS=1000        # longest question accepted (422 above this)
# 0 = use the direct client address; 1 = behind one proxy (Render)
TRUSTED_PROXY_HOPS=0
# Salt for hashing visitor addresses (raw IPs are never stored). Change it in production.
VISITOR_SALT=change-me

# --- Demo ---------------------------------------------------------------------
# The fictional coalition is frozen at this date so every figure is reproducible.
STATUS_DATE=2026-10-17

# --- Integrations ---------------------------------------------------------------
# Optional: approved hub notices are posted here; otherwise approvals run as a dry run.
SLACK_WEBHOOK_URL=
